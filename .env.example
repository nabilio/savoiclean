# --- Base de données MySQL (Hostinger) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Sécurité ---
# Chaîne aléatoire de 32 caractères minimum (signe les sessions et chiffre les secrets 2FA)
APP_SECRET=
# Jeton à saisir une seule fois pour créer le compte administrateur (/admin/setup)
SETUP_TOKEN=

# --- Site ---
SITE_URL=https://votre-domaine.tld
# true uniquement quand le vrai nom de domaine est branché (sinon le site reste en noindex)
ALLOW_INDEXING=false

# --- E-mail aux admins à chaque nouvelle demande (facultatif) ---
# Option 1 (recommandée) : boîte mail Hostinger. Ex. SMTP_HOST=smtp.hostinger.com SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Option 2 : Resend
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_FROM=
