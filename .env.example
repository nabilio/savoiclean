# --- Base de données MySQL (Hostinger) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Sécurité ---
# Chaîne aléatoire de 32 caractères minimum (signe les sessions et chiffre les secrets 2FA)
APP_SECRET=
# Jeton à saisir une seule fois pour créer le compte administrateur (/admin/setup)
SETUP_TOKEN=

# --- Site ---
SITE_URL=https://votre-domaine.tld
# true uniquement quand le vrai nom de domaine est branché (sinon le site reste en noindex)
ALLOW_INDEXING=false

# --- Notification e-mail des demandes (facultatif, via Resend) ---
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_FROM=
